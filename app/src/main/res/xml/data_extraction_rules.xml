<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: sem backup na nuvem nem transferência entre aparelhos (token e fila de GPS ficam só aqui). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
